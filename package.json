{
  "name": "genesys-conversation-stitcher",
  "version": "0.1.0",
  "description": "Turns the partial, duplicated, out-of-order Genesys Cloud conversation event stream into one clean record per conversation.",
  "keywords": [
    "genesys",
    "genesys-cloud",
    "contact-center",
    "conversation",
    "events",
    "event-stream",
    "deduplication",
    "stream-processing",
    "typescript"
  ],
  "author": "Oscar Benavides (https://ob0.dev)",
  "license": "MIT",
  "homepage": "https://github.com/oebh2408/genesys-conversation-stitcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oebh2408/genesys-conversation-stitcher.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "genesys-conversation-stitcher": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "demo": "tsc && node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
